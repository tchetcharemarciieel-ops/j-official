# Supabase (Paramètres du projet > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur uniquement — ne jamais préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# IA (facultatif : sans clé, le système de secours par mots-clés est utilisé et signalé comme tel)
# Clés serveur uniquement — ne jamais préfixer par NEXT_PUBLIC_
AI_PROVIDER=gemini            # openai | anthropic | gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=                     # vide = gemini-3.8-flash, gpt-5-mini ou claude-opus-5-5 selon le fournisseur
# Modèles de secours essayés automatiquement quand le précédent atteint sa limite (429, surcharge…).
# Vide = modèles gratuits du même fournisseur (Gemini : 3.5-flash → 3.5-flash-lite → 3.1-flash-lite),
# puis le service compatible OpenAI ci-dessous s'il est configuré. « aucun » pour désactiver.
# AI_FALLBACK_MODELS=gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite,compat:auto
# Service compatible OpenAI en dernier recours (FreeLLMAPI auto-hébergé, OpenRouter, Groq…)
# AI_COMPAT_BASE_URL=https://votre-freellmapi.exemple/v1
# AI_COMPAT_API_KEY=
# AI_COMPAT_MODEL=auto
# AI_COMPAT_LABEL=FreeLLMAPI
# AI_CHAIN_BUDGET_MS=80000      # au-delà, passage direct au système de secours par mots-clés
# AI_REASONING_EFFORT=low     # modèles OpenAI gpt-5 / o* uniquement
# AI_TIMEOUT_MS=110000
# AI_PRICE_INPUT_USD= / AI_PRICE_OUTPUT_USD=   # prix par million de jetons, pour le suivi des coûts
# Limites anti-abus (analyses IA)
AI_USER_HOURLY_LIMIT=10
AI_USER_DAILY_LIMIT=30
AI_GLOBAL_DAILY_LIMIT=300
AI_IP_BURST_LIMIT=20          # requêtes d'analyse par IP et par compte en 10 minutes

# Adresse publique de la plateforme (liens publiés)
NEXT_PUBLIC_SITE_URL=https://minisoft-rca.vercel.app

# E-mails des administrateurs de la plateforme, séparés par des virgules
ADMIN_EMAILS=
